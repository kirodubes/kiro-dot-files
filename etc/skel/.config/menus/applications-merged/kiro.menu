<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
    "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
    <Name>Applications</Name>
    <Menu>
        <Name>Kiro</Name>
        <Directory>kiro.directory</Directory>
        <Include>
            <Category>X-Kiro</Category>
        </Include>
        <Layout>
            <Filename>kiro-news.desktop</Filename>
            <Filename>kiro-link-website.desktop</Filename>
            <Filename>kiro-link-releases.desktop</Filename>
            <Filename>kiro-link-discussions.desktop</Filename>
            <Filename>kiro-link-code.desktop</Filename>
            <Filename>kiro-assistant.desktop</Filename>
            <Merge type="all"/>
        </Layout>
    </Menu>
    <Menu>
        <Name>Kiro Apps</Name>
        <Directory>kiro-apps.directory</Directory>
        <Include>
            <Category>X-Kiro-Apps</Category>
        </Include>
        <Layout>
            <Filename>archlinux-tweak-tool.desktop</Filename>
            <Filename>kiro-iso-builder.desktop</Filename>
            <Filename>alacritty-tweak-tool.desktop</Filename>
            <Filename>fastfetch-tweak-tool.desktop</Filename>
            <Filename>fish-tweak-tool.desktop</Filename>
            <Filename>archlinux-logout-settings.desktop</Filename>
            <Filename>archlinux-betterlockscreen.desktop</Filename>
            <Merge type="all"/>
        </Layout>
    </Menu>
</Menu>
