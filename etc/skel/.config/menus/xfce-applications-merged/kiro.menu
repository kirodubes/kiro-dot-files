<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
    "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
    <Name>Applications</Name>
    <Menu>
        <Name>Kiro</Name>
        <Directory>kiro.directory</Directory>
        <Include>
            <Category>X-Kiro</Category>
        </Include>
        <Layout>
            <Filename>kiro-news.desktop</Filename>
            <Filename>kiro-link-website.desktop</Filename>
            <Filename>kiro-link-releases.desktop</Filename>
            <Filename>kiro-link-discussions.desktop</Filename>
            <Filename>kiro-link-code.desktop</Filename>
            <Merge type="all"/>
        </Layout>
    </Menu>
</Menu>
